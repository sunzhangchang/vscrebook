{
  "name": "vscrebook",
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "txt",
    "novel",
    "book",
    "小说",
    "神器",
    "摸鱼",
    "划水"
  ],
  "publisher": "Cyanogenaq",
  "bugs": {
    "url": "https://github.com/sunzhangchang/vscrebook/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunzhangchang/vscrebook"
  },
  "homepage": "https://github.com/sunzhangchang/vscrebook/blob/main/README.md",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "script": "node scripts/script.mjs",
    "ext:build:dev": "pnpm run script ext build dev",
    "lint": "oxlint . --ignore-pattern node_modules/** --ignore-pattern target/** --ignore-pattern packages/crawl/pkg/** --ignore-pattern apps/vscode-extension/dist/**",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "desktop:dev": "pnpm --filter vscrebook-desktop tauri dev",
    "build": "pnpm --filter ./apps/vscode-extension run build"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "binaryen": "^132.0.0",
    "rolldown": "^1.3.3",
    "@types/lodash": "^4.14.186",
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.106.0",
    "fancy-log": "^2.0.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chardet": "^2.1.0",
    "iconv-lite": "^0.6.3",
    "lodash": "^4.17.21"
  }
}
